# distances: intra-quadrant 10, cross-quadrant 12, any->CXL 18 (uniform)

## CXL: UNCHANGED by the BIOS visit
# decoder0.0 size 242.5 GiB ways=2 gran=256   (Pair A window 1 -> dax0.0)
# decoder0.1 size 269.5 GiB ways=2 gran=256   (Pair A window 2 -> dax1.0)
# decoder0.2 size 512.0 GiB ways=2 gran=256   (Pair B -> dax2.0, famfs FUSE, root)
